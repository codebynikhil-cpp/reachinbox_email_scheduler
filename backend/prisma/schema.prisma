generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String     @id @default(uuid())
  googleId  String     @unique
  name      String
  email     String     @unique
  avatarUrl String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Slack Integration
  slackConnected   Boolean  @default(false)
  slackWebhookUrl  String?
  slackAccessToken String?
  slackChannel     String?
  slackTeamName    String?

  campaigns Campaign[]

  @@map("users")
}

model Campaign {
  id          String    @id @default(uuid())
  userId      String
  subject     String
  body        String    @db.Text
  startTime   DateTime
  delayMs     Int
  hourlyLimit Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails Email[]

  @@index([userId])
  @@index([createdAt])
  @@map("campaigns")
}

model Email {
  id          String      @id @default(uuid())
  campaignId  String
  recipient   String
  scheduledAt DateTime
  sentAt      DateTime?
  status      EmailStatus @default(SCHEDULED)
  attempts    Int         @default(0)
  messageId   String?
  error       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([status, scheduledAt])
  @@index([recipient])
  @@index([scheduledAt])
  @@index([status])
  @@map("emails")
}
